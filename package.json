{
  "name": "eguitar-omitrix",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/build.mjs && node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "predev": "node scripts/prepare-score-assets.mjs",
    "prestart": "node scripts/prepare-score-assets.mjs",
    "prebuild": "node scripts/prepare-score-assets.mjs",
    "desktop:setup": "install-electron",
    "desktop": "npm run build && electron desktop",
    "test:web": "playwright test --config tests/e2e/playwright.config.mjs",
    "test:desktop": "node scripts/verify-desktop.mjs",
    "package:windows": "npm run build && electron-builder --config electron-builder.config.cjs --win nsis --x64 --publish never && node scripts/artifact-manifest.mjs release/windows",
    "android:sync": "npm run build && cap sync android",
    "package:android": "npm run android:sync && node scripts/package-android.mjs",
    "release:check": "node scripts/check-release.mjs",
    "postinstall": "npm ci --prefix desktop --ignore-scripts",
    "package:mac": "npm run build && electron-builder --config electron-builder.config.cjs --mac dmg zip --arm64 --x64 -c.directories.output=release/mac --publish never && node scripts/artifact-manifest.mjs release/mac",
    "typecheck": "tsc --noEmit",
    "lint": "eslint frontend",
    "test:ui": "vitest run"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@coderline/alphatab": "1.8.4",
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "31.0.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "license": "MIT"
}
