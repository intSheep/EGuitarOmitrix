{
  "name": "eguitar-omitrix",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "predev": "node scripts/prepare-score-assets.mjs",
    "prestart": "node scripts/prepare-score-assets.mjs",
    "prebuild": "node scripts/prepare-score-assets.mjs",
    "desktop:setup": "install-electron",
    "desktop": "npm run build && electron desktop",
    "test:web": "playwright test --config tests/e2e/playwright.config.mjs",
    "test:desktop": "node scripts/verify-desktop.mjs",
    "package:windows": "npm run build && electron-builder --config electron-builder.config.cjs --win nsis --x64 --publish never && node scripts/artifact-manifest.mjs release/windows",
    "android:sync": "npm run build && cap sync android",
    "package:android": "npm run android:sync && node scripts/package-android.mjs",
    "release:check": "node scripts/check-release.mjs",
    "postinstall": "npm ci --prefix desktop --ignore-scripts",
    "package:mac": "npm run build && electron-builder --config electron-builder.config.cjs --mac dmg zip --arm64 --x64 -c.directories.output=release/mac --publish never && node scripts/artifact-manifest.mjs release/mac"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@coderline/alphatab": "1.8.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "1.64.1",
    "electron": "44.9.1",
    "electron-builder": "26.15.3"
  },
  "license": "MIT"
}
